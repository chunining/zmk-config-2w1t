#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        /*
         * No zmk,matrix-transform here on purpose.
         * ZMK Studio needs the physical layout to own the transform,
         * and having both set stops Studio from starting.
         */
    };

    /*
     * 6 columns x 5 rows.  Diodes run switch -> anode -> cathode -> ROW,
     * so current flows column to row: diode-direction = "col2row".
     * Pin numbers come straight out of 2W1TMacro.kicad_pcb.
     */
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios
            = <&gpio0  2 GPIO_ACTIVE_HIGH>   /* COL 0  P0.02 */
            , <&gpio1 15 GPIO_ACTIVE_HIGH>   /* COL 1  P1.15 */
            , <&gpio1 13 GPIO_ACTIVE_HIGH>   /* COL 2  P1.13 */
            , <&gpio1  2 GPIO_ACTIVE_HIGH>   /* COL 3  P1.02 */
            , <&gpio1  1 GPIO_ACTIVE_HIGH>   /* COL 4  P1.01 */
            , <&gpio1  6 GPIO_ACTIVE_HIGH>   /* COL 5  P1.06 */
            ;

        row-gpios
            = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW 0  P0.22 */
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW 1  P0.24 */
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW 2  P1.00 */
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW 3  P0.11 */
            , <&gpio1  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW 4  P1.04 */
            ;
    };

    /*
     * Column 5 is the 5-way switch: its five directions land on rows 0-4
     * in the order Left, Right, Up, Down, Center.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)   RC(3,5)
                                                      RC(4,5)
        >;
    };

    /*
     * Where every key physically sits, so ZMK Studio can draw the board.
     * Units are centi-key-units: 100 = 1u = 19.05 mm.  Origin is the
     * top-left corner of the first key; every number below is measured
     * off 2W1TMacro.kicad_pcb.
     *
     * Order must match the transform map above, row by row.
     * The 5-way is drawn as five 0.5u caps in a cross, centred on the
     * real part at (5.43u, 4.12u).
     */
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "2W1T Macro";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //            w    h    x    y  rot  rx  ry
            = <&key_physical_attrs 100 100    0    0    0   0   0>
            , <&key_physical_attrs 100 100  100    0    0   0   0>
            , <&key_physical_attrs 100 100  200    0    0   0   0>
            , <&key_physical_attrs 100 100  300    0    0   0   0>   /* left wheel press  */
            , <&key_physical_attrs 100 100  400    0    0   0   0>   /* right wheel press */
            , <&key_physical_attrs  50  50  468  387    0   0   0>   /* 5-way left   */

            , <&key_physical_attrs 100 100    0  100    0   0   0>
            , <&key_physical_attrs 100 100  100  100    0   0   0>
            , <&key_physical_attrs 100 100  200  100    0   0   0>
            , <&key_physical_attrs 100 100  300  100    0   0   0>
            , <&key_physical_attrs 100 100  400  100    0   0   0>
            , <&key_physical_attrs  50  50  568  387    0   0   0>   /* 5-way right  */

            , <&key_physical_attrs 100 100    0  200    0   0   0>
            , <&key_physical_attrs 100 100  100  200    0   0   0>
            , <&key_physical_attrs 100 100  200  200    0   0   0>
            , <&key_physical_attrs 100 100  300  200    0   0   0>
            , <&key_physical_attrs 100 100  400  200    0   0   0>
            , <&key_physical_attrs  50  50  518  337    0   0   0>   /* 5-way up     */

            , <&key_physical_attrs 100 100    0  300    0   0   0>
            , <&key_physical_attrs 100 100  100  300    0   0   0>
            , <&key_physical_attrs 100 100  200  300    0   0   0>
            , <&key_physical_attrs 100 100  300  300    0   0   0>
            , <&key_physical_attrs 100 100  400  300    0   0   0>
            , <&key_physical_attrs  50  50  518  437    0   0   0>   /* 5-way down   */

            , <&key_physical_attrs  50  50  518  387    0   0   0>   /* 5-way center */
            ;
    };

    /* CKW12 roller, left position (SW1) */
    wheel_left: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   /* W1A  P0.17 */
        b-gpios = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   /* W1B  P0.20 */
        steps = <24>;
        status = "okay";
    };

    /* CKW12 roller, right position (SW3) */
    wheel_right: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   /* W2A  P0.31 */
        b-gpios = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   /* W2B  P0.29 */
        steps = <24>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&wheel_left &wheel_right>;
        triggers-per-rotation = <12>;
    };
};
