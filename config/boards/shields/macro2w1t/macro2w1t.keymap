#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * TEST LAYER
         * Every position types a different letter so you can prove each
         * switch, both encoder pushes and all five nav directions work.
         * Open a text editor, press everything, compare with this table:
         *
         *   physical            letter
         *   -------------------------------------------
         *   top row, keys 1-3    A B C
         *   left roller push     S
         *   right roller push    T
         *   2nd row              D E F G H
         *   3rd row              I J K L M
         *   4th row              N O P Q R
         *   5-way left           U
         *   5-way right          V
         *   5-way up             W
         *   5-way down           X
         *   5-way press          Y
         *   left roller turn     1 / 2
         *   right roller turn    3 / 4
         *
         * Anything that types the wrong letter means that row/column pair
         * is swapped; anything that types nothing is an open circuit.
         * Replace this layer with real bindings once it all checks out.
         */
        test_layer {
            bindings = <
                &kp A  &kp B  &kp C  &kp S  &kp T     &kp U
                &kp D  &kp E  &kp F  &kp G  &kp H     &kp V
                &kp I  &kp J  &kp K  &kp L  &kp M     &kp W
                &kp N  &kp O  &kp P  &kp Q  &kp R     &kp X
                                                      &kp Y
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp UP DOWN>;
        };
    };
};
